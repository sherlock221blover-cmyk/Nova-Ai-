{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and NOVA companion settings without sensitive PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "preferredName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64
        },
        "preferredLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "voiceName": {
          "type": "string",
          "enum": ["Kore", "Zephyr"]
        },
        "voiceStyle": {
          "type": "string",
          "enum": ["warm", "calm", "playful"]
        },
        "autoSpeak": {
          "type": "boolean"
        },
        "webSearchDefault": {
          "type": "boolean"
        },
        "autoMemoryExtract": {
          "type": "boolean"
        },
        "playfulJealousy": {
          "type": "boolean"
        },
        "currentMood": {
          "type": "string",
          "enum": ["happy", "calm", "excited", "tired", "stressed", "anxious", "sad", "overwhelmed"]
        },
        "currentMoodNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "currentMoodUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "preferredName", "preferredLanguage", "voiceName", "voiceStyle", "autoSpeak", "webSearchDefault", "autoMemoryExtract", "createdAt", "updatedAt"]
    },
    "MemoryItem": {
      "title": "MemoryItem",
      "description": "A user-approved long-term memory entry remembered by NOVA.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["preference", "identity", "interest", "goal", "language", "note"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "type": "string",
          "enum": ["manual", "assistant"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "category", "content", "source", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A single message in the persistent NOVA conversation thread.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "assistant"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "usedSearch": {
          "type": "boolean"
        },
        "sourceUrls": {
          "type": "array",
          "description": "Up to 10 verified web source URLs returned from Google Search grounding."
        },
        "sourceTitles": {
          "type": "array",
          "description": "Up to 10 web source titles matching sourceUrls."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "role", "text", "usedSearch", "sourceUrls", "sourceTitles", "createdAt"]
    },
    "AutomationRoutine": {
      "title": "AutomationRoutine",
      "description": "A user-authorized assistant workflow routine.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "actionType": {
          "type": "string",
          "enum": ["briefing", "study_plan", "task_sync", "chat_digest"]
        },
        "scheduleTime": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "title", "description", "actionType", "scheduleTime", "enabled", "createdAt", "updatedAt"]
    },
    "MoodLog": {
      "title": "MoodLog",
      "description": "A mood check-in logged by Muhib to tailor NOVA's emotional support.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mood": {
          "type": "string",
          "enum": ["happy", "calm", "excited", "tired", "stressed", "anxious", "sad", "overwhelmed"]
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "mood", "note", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user NOVA companion preferences, current mood, and voice settings."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/MemoryItem" },
      "description": "User's long-term memories remembered by NOVA."
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Persistent multi-turn conversation messages between the user and NOVA."
    },
    "/users/{userId}/automations/{automationId}": {
      "schema": { "$ref": "#/entities/AutomationRoutine" },
      "description": "User-authorized assistant automation routines."
    },
    "/users/{userId}/moods/{moodId}": {
      "schema": { "$ref": "#/entities/MoodLog" },
      "description": "Mood check-in history logged by the owner."
    }
  }
}
